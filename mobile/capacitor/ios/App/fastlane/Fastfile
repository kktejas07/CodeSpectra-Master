# CodeSpectra iOS — TestFlight upload (used by .github/workflows/ios.yml).
#
# Env (GitHub secrets):
#   APPLE_TEAM_ID                         10-char Apple Developer team id
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_B64   App Store Connect API key (App Manager role)
#   Signing, one of:
#     MATCH_GIT_URL, MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION   fastlane match (readonly)
#     IOS_DIST_CERT_P12_B64, IOS_DIST_CERT_PASSWORD, IOS_PROVISION_PROFILE_B64,
#     IOS_PROVISION_PROFILE_NAME                                   manual
#   CS_IAP_ENABLED                        "YES" only once StoreKit IAP is integrated
#   BUILD_NUMBER                          CI run number
require "base64"
require "tmpdir"

default_platform(:ios)

BUNDLE_ID = ENV.fetch("IOS_BUNDLE_ID", "ai.codespectra.app")
PROJECT = "App.xcodeproj"

platform :ios do
  desc "Build a signed App Store archive and upload it to TestFlight"
  lane :beta do
    setup_ci # temporary keychain on CI

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_B64"),
      is_key_content_base64: true,
      in_house: false,
    )

    profile_name = nil
    if ENV["MATCH_GIT_URL"].to_s != ""
      match(type: "appstore", app_identifier: BUNDLE_ID, readonly: true, api_key: api_key)
      profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]
    else
      p12 = File.join(Dir.tmpdir, "dist.p12")
      File.binwrite(p12, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_B64")))
      import_certificate(certificate_path: p12, certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"), keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain", keychain_password: "")
      profile = File.join(Dir.tmpdir, "dist.mobileprovision")
      File.binwrite(profile, Base64.decode64(ENV.fetch("IOS_PROVISION_PROFILE_B64")))
      install_provisioning_profile(path: profile)
      profile_name = ENV.fetch("IOS_PROVISION_PROFILE_NAME")
      File.delete(p12)
    end

    update_code_signing_settings(
      path: PROJECT, targets: ["App"], use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"), bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution", profile_name: profile_name,
    )
    increment_build_number(xcodeproj: PROJECT, build_number: ENV.fetch("BUILD_NUMBER", "1"))

    build_app(
      project: PROJECT, scheme: "App", configuration: "Release",
      export_method: "app-store", clean: true, output_directory: "build", output_name: "CodeSpectra.ipa",
      xcargs: "CS_IAP_ENABLED=#{ENV.fetch('CS_IAP_ENABLED', 'NO')} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile_name } },
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
