{
  "expo": {
    "name": "CodeSpectra",
    "slug": "codespectra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.appiconset/1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "1.9.24",
            "jdkVersion": "17"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.codespectra.mobile",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "dev.codespectra.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.appiconset/512.png",
        "backgroundColor": "#09090b"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6355ce0d-4fab-4c1c-b8ff-c0d06adcfd2b"
      }
    },
    "owner": "devendervutukuru"
  }
}
