{
  "expo": {
    "name": "CodeSpectra",
    "slug": "codespectra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080D17",
    "icon": "./assets/icon.png",
    "scheme": "codespectra",
    "primaryColor": "#00D681",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.codespectra.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CodeSpectra uses the camera for proctored assessments and face verification."
      }
    },
    "android": {
      "package": "ai.codespectra.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080D17"
      }
    },
    "extra": {
      "apiBase": "https://codespectra.ai",
      "eas": {
        "projectId": "fba9d16f-751a-4242-ac8c-25fd9edc382d"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#080D17",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#080D17"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00D681"
        }
      ]
    ],
    "owner": "devendervutukuru"
  }
}
