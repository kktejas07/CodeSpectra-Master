{
  "expo": {
    "name": "CodeSpectra",
    "slug": "codespectra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080D17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.codespectra.app"
    },
    "android": {
      "package": "ai.codespectra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080D17"
      }
    },
    "extra": {
      "apiBase": "https://codespectra.ai"
    }
  }
}
