{
  "expo": {
    "name": "CodeSpectra",
    "slug": "codespectra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080D17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.codespectra.app"
    },
    "android": {
      "package": "ai.codespectra.app"
    },
    "extra": {
      "apiBase": "https://codespectra.ai"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080D17",
          "dark": { "backgroundColor": "#080D17" },
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
