# =============================================================================
# CodeSpectra Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp backend/.env.example backend/.env
# NEVER commit the actual .env file to version control.
# =============================================================================

# MongoDB connection (required)
# Use your Atlas SRV URI or local mongodb:// connection string.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=codespectra

# Alternate variable names accepted by backend config (optional — equivalents)
MONGODB_URI=
MONGODB_DB_NAME=codespectra

# Database name (default: codespectra)
DB_NAME=codespectra

# Allowed CORS origins (comma-separated)
# Used by the FastAPI proxy for CORS header injection.
CORS_ORIGINS=http://localhost:3000

# Next.js internal URL (where FastAPI forwards /api/* requests)
NEXTJS_INTERNAL_URL=http://localhost:3000

# Internal shared secret for backend auth (required for production)
# Next.js API routes pass this in the x-internal-secret header when calling
# /internal/* routers. Must match the INTERNAL_BACKEND_SECRET env var set in
# the frontend .env.local. Generate with: openssl rand -hex 32
INTERNAL_BACKEND_SECRET=YOUR_STRONG_INTERNAL_SECRET_HERE

# Shared API key for Anthropic, Gemini, and other LLM providers.

# Anthropic API key (optional — direct Claude access)
ANTHROPIC_API_KEY=

# Google Gemini API key (optional — has free tier)
GEMINI_API_KEY=

# Generic LLM gateway key (optional — fallback provider key)
LLM_API_KEY=

# YouTube Data API key (optional — course content discovery; empty returns [])
YOUTUBE_API_KEY=

# ATS webhook secret (optional — verifies inbound ATS webhooks, e.g. Merge.dev)
ATS_WEBHOOK_SECRET=

# ATS webhook allowlist, comma-separated (optional)
ATS_WEBHOOK_ALLOWLIST=https://api.merge.dev/v1/ats/webhooks

# Session JWT secret (required in production — must match frontend SESSION_SECRET)
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Shared secret for /api/cron/* HTTP endpoints (required in production)
# Generate: openssl rand -hex 32
CRON_SECRET=
