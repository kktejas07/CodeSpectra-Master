    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome'",
    "test:api": "playwright test tests/api",
    "test:auth": "playwright test tests/auth",
    "test:crud": "playwright test tests/crud",
    "test:forms": "playwright test tests/forms",
    "test:tables": "playwright test tests/tables",
    "test:accessibility": "playwright test tests/accessibility",
    "test:performance": "playwright test tests/performance",
    "test:visual": "playwright test tests/visual",
    "test:navigation": "playwright test tests/navigation",
    "test:ui": "playwright test tests/ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
