# ──────────────────────────────────────────────────────
# LiveKit (real-time video/audio for interviews)
# ──────────────────────────────────────────────────────
# Self-hosted (docker-compose up livekit):
#   The bundled docker-compose already runs a LiveKit dev server on ws://localhost:7880.
#   In dev mode the token route falls back to devkey/dev-secret automatically — no env needed.
#
# Production self-hosted:
#   1. Remove `--dev` from the livekit service command.
#   2. Mount a livekit.conf with static keys and TLS:
#        LIVEKIT_API_KEY=<your-chosen-key>
#        LIVEKIT_API_SECRET=<random-64-char-hex>
#   3. Add a TURN server (coturn) for NAT traversal — LiveKit docs: https://docs.livekit.io/infra/livekit-server/config/
#
# LiveKit Cloud (free tier — 25 h/month):
#   1. Sign up at https://cloud.livekit.io
#   2. Create a project and copy the API key, secret, and WebSocket URL.
#   3. Set these env vars in your deployment:
LIVEKIT_URL=           # wss://your-project.livekit.cloud
LIVEKIT_API_KEY=       # from LiveKit Cloud dashboard
LIVEKIT_API_SECRET=    # from LiveKit Cloud dashboard
#
# TURN/TLS notes for production:
#   - LiveKit Cloud handles TURN + TLS automatically.
#   - Self-hosted: run coturn behind TLS, point livekit.conf to it.
#   - Without TURN, clients behind strict firewalls/NAT will fail to connect.
# ──────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────
# Cloudflare Turnstile (bot defense for login/signup/reset)
# ──────────────────────────────────────────────────────
# Get keys at https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # public site key (widget renders in browser)
# TURNSTILE_SECRET_KEY=            # secret key (server-side verification only)
# When keys are absent, verification is skipped (fail-open) so deploys
# never lock users out before the admin configures Turnstile.
# ──────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════
# Everything below is read by the Next.js app (process.env).
# REQUIRED = the app fails or a core flow breaks without it in production.
# Many provider keys can ALSO be set in Superadmin → Settings (stored in Mongo);
# an env var, when set, wins. Leave optional ones empty to disable the feature.
# ══════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────
MONGODB_URI=                    # REQUIRED  mongodb://user:pass@host:27017 (MONGO_URL is accepted as an alias)
# MONGO_URL=
MONGODB_DB_NAME=codespectra     # optional, default "codespectra"
# MONGODB_URI_FALLBACK=         # optional second URI tried when the first is unreachable
NEXT_PUBLIC_APP_URL=            # REQUIRED in prod  public origin, e.g. https://codespectra.ai (links in emails, referral URLs)
# CODESPECTRA_APP_URL=          # optional server-side override of the public origin
# NEXT_PUBLIC_API_URL=          # optional absolute API base for server-rendered fetches (default: same origin)
SESSION_SECRET=                 # recommended  JWT signing secret; if unset it is generated and stored in Mongo (prod throws if it can't persist)
JWT_SECRET=                     # REQUIRED  HMAC for newsletter unsubscribe links (NEXTAUTH_SECRET is accepted as an alias). Without it a public default is used — set it.
# NEXTAUTH_SECRET=
CRON_SECRET=                    # REQUIRED for /api/cron/* (external scheduler sends it); cron routes fail closed in prod without it
# NEXT_PUBLIC_DISABLE_SCHEDULER=1   # optional: stop the in-process scheduler (workflow tick, trial expiry)
# HOSTNAME=                     # optional worker name in course-job logs

# ── Firebase (Google/GitHub sign-in, push) ────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=        # web push
FIREBASE_PROJECT_ID=                   # admin SDK (server). Without these, OAuth sign-in is off; password login still works.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                  # keep the \n escapes, wrap in quotes

# ── Turnstile (server key alias) ──────────────────────
# TURNSTILE_SITE_KEY=           # server-side alias of NEXT_PUBLIC_TURNSTILE_SITE_KEY (served via /api/config/public)

# ── Redis (rate limits, locks) ────────────────────────
UPSTASH_REDIS_REST_URL=         # https://…upstash.io  or  redis://host:6379 ; empty = in-memory limits (single instance only)
UPSTASH_REDIS_REST_TOKEN=

# ── Code execution (Piston sandbox) ───────────────────
PISTON_URL=http://piston:2000/api/v2
# PISTON_MAX_CONCURRENT=        # optional concurrency cap
# PISTON_RUN_TIMEOUT_MS=        # optional per-run timeout
# ALLOW_LOCAL_EXEC=1            # DANGER: run code on the host when Piston is down (never in prod)

# ── Internal Python backend ───────────────────────────
INTERNAL_BACKEND_URL=           # e.g. http://codespectra-backend:8000 (upload virus scan, LLM health). Set it — a hard-coded prod hostname is the fallback.
INTERNAL_BACKEND_SECRET=        # shared secret for app → backend calls
# INTERNAL_FASTAPI_URL=         # codebase chat service, default http://localhost:8001
# COURSE_WORKER=1               # this instance runs the course video worker
# REMOTION_BROWSER_EXECUTABLE=  # Chromium path for course MP4 rendering

# ── AI providers (any one is enough; also configurable in admin) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OPENCODE_API_KEY=
# CUSTOM_ENDPOINT=              # OpenAI-compatible base URL
# CUSTOM_MODEL=
# TYPESAFE_API_KEY=             # JEV agreement checks
# AI_INVENTORY_REAL_AUDIT=1     # run real (paid) AI inventory audits outside prod

# ── Email ─────────────────────────────────────────────
POSTAL_SERVER=                  # REQUIRED for any email (verification, reset, invites)
POSTAL_API_KEY=
POSTAL_FROM_EMAIL=              # e.g. no-reply@codespectra.ai
CONTACT_INBOX=support@codespectra.ai   # where /contact messages go
# RESEND_API_KEY=               # only reported on the status page
# SENDGRID_API_KEY=

# ── File storage (one of R2 or S3) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Payments (enable the ones you use) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PHONEPE_ENABLED=true
# PHONEPE_ENVIRONMENT=          # SANDBOX | PRODUCTION
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=

# ── Identity verification (Didit KYC) ─────────────────
# DIDIT_API_KEY=
# DIDIT_WEBHOOK_SECRET=

# ── Integrations ──────────────────────────────────────
# GITHUB_WEBHOOK_SECRET=        # verifies GitHub push/PR webhooks
# GITHUB_CLIENT_ID=             # legacy integrations connect (see audit E15)
# SLACK_CLIENT_ID=
# SONARQUBE_CLIENT_ID=
# SONARQUBE_URL=
# CLOUDFLARE_API_TOKEN=         # admin CDN purge
# CLOUDFLARE_ZONE_ID=

# ── Dev only ──────────────────────────────────────────
# SEED_DEV_ENABLED=1            # allow /api/auth/seed-dev in production (don't)
# SEED_PASSWORD=                # password for seeded dev users
