{
  "manifest_version": 3,
  "name": "CodeSpectra Device Audit",
  "version": "1.0.5",
  "description": "Detects USB/HID/storage devices during proctored assessments. Pen drives, peripherals, and hotplug events flagged in real time.",
  "permissions": [
    "system.storage",
    "hid",
    "usb",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://codespectra.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codespectra.ai/assessment/*",
        "https://codespectra.ai/assessment/invite/*",
        "https://codespectra.ai/dashboard/assessments/*",
        "https://codespectra.ai/dashboard/admin/assessments/*"
      ],
      "js": ["lib/classify.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeSpectra Device Audit"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "privacy_policy": "https://codespectra.ai/privacy"
}
