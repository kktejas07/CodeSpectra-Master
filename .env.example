# =============================================================================
# CodeSpectra — Complete Environment Variable Reference
# =============================================================================
# Copy this file to .env (or backend/.env / frontend/.env.local as appropriate)
# and fill in your values. NEVER commit .env files to version control.
#
# Required: marked (required)
# Optional: marked (optional) with default shown
# Public:   safe to share (client-side accessible via NEXT_PUBLIC_ prefix)
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────

# MongoDB connection string (required — frontend uses this server-side)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Optional fallback URI (used if primary fails to connect)
MONGODB_URI_FALLBACK=
# Database name (optional — default: codespectra)
MONGODB_DB_NAME=codespectra

# ─── Authentication ──────────────────────────────────────────────────────────

# Session JWT secret (required in production)
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Firebase Admin SDK credentials (optional — fallback JWT auth used if absent)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client config (public — exposed to browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── AI / LLM ────────────────────────────────────────────────────────────────

# Emergent LLM gateway key (required for AI features)
# Single key used for Anthropic, Gemini, and other providers.

# OpenAI API key (optional — used by interview service via Vercel AI SDK)
OPENAI_API_KEY=

# Anthropic API key (optional — direct Claude access)
ANTHROPIC_API_KEY=

# Google Gemini API key (optional — has free tier)
GEMINI_API_KEY=

# Groq API key (optional — fast inference)
GROQ_API_KEY=

# NVIDIA NIM API key (optional — hosted model inference)
NVIDIA_API_KEY=

# OpenCode API key (optional — agentic coding provider)
OPENCODE_API_KEY=

# OpenRouter API key (optional — multi-provider gateway)
OPENROUTER_API_KEY=

# Generic LLM gateway key (optional — fallback provider key)
LLM_API_KEY=

# ─── Code Execution (Piston) ─────────────────────────────────────────────────

# Piston API URL (optional — default: http://piston:2000/api/v2 in Docker)
# For local development against Docker: http://localhost:2000/api/v2
PISTON_URL=

# Per-run timeout in ms (optional — default: 5000)
PISTON_RUN_TIMEOUT_MS=

# Max concurrent executions, 0 = unlimited (optional — default: 0)
PISTON_MAX_CONCURRENT=

# Allow in-process local code execution (optional — default: allowed in
# development only). The local executor runs arbitrary code in-process, often
# as root — NEVER set ALLOW_LOCAL_EXEC=1 in production.
ALLOW_LOCAL_EXEC=

# ─── Identity Verification (Didit) ───────────────────────────────────────────

# Didit API key (optional — required for KYC identity verification)
DIDIT_API_KEY=

# Didit webhook secret (optional — verifies webhook signatures)
DIDIT_WEBHOOK_SECRET=

# Didit workflow ID (optional — selects the verification workflow)
DIDIT_WORKFLOW_ID=

# ─── GitHub Integration ──────────────────────────────────────────────────────

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App credentials (for webhook-based scanning)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# GitHub webhook secret (required if GitHub webhooks are configured)
# If empty, unsigned webhooks are rejected.
GITHUB_WEBHOOK_SECRET=

# Encryption key for GitHub OAuth tokens at rest (optional)
# Generate: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# ─── Billing ─────────────────────────────────────────────────────────────────

# Razorpay credentials (required for payment processing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe credentials (optional — currently stubbed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────

# Resend API key (optional — primary email provider)
RESEND_API_KEY=

# SendGrid API key (optional — fallback email provider)
SENDGRID_API_KEY=

# Postal server URL (optional — self-hosted email)
POSTAL_SERVER=
POSTAL_API_KEY=
POSTAL_FROM_EMAIL=

# SMTP settings (optional — generic SMTP fallback)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Rate Limiting ───────────────────────────────────────────────────────────

# Upstash Redis (optional — enables distributed rate limiting)
# Uses in-memory rate limiting as fallback when not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron / Background Jobs ──────────────────────────────────────────────────

# Shared secret for /api/cron/* HTTP endpoints (required in production for external cron).
# Generate: openssl rand -hex 32
# Set in Dokploy → frontend Environment as CRON_SECRET, then call:
#   https://your-domain/api/cron/tick?secret=<value>
# Or header: Authorization: Bearer <value>
# Without this, Cron Jobs UI shows "Needs CRON_SECRET" (in-process loops still run).
CRON_SECRET=

# ─── LiveKit (Interview Rooms) ───────────────────────────────────────────────

# LiveKit WebSocket URL (required for interview rooms)
# Dev: ws://localhost:7880 (docker compose up livekit)
# Prod: wss://your-livekit-host:443 — needs TLS + static API keys
#        Set --keys in livekit.conf and use TURN for NAT traversal
LIVEKIT_URL=ws://localhost:7880

# LiveKit API key (dev: 'devkey', prod: set via --config livekit.conf)
LIVEKIT_API_KEY=devkey

# LiveKit API secret (dev: auto-generated with --dev, prod: set static value)
# Generate: openssl rand -hex 32
LIVEKIT_API_SECRET=

# ─── Application ─────────────────────────────────────────────────────────────

# Environment mode (development | production)
# In production, authentication is enforced on all backend endpoints.
ENVIRONMENT=development

# Public app URL (public — used for links in emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS origins for FastAPI proxy (comma-separated, default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Next.js internal URL (where FastAPI forwards /api/* requests)
NEXTJS_INTERNAL_URL=http://localhost:3000

# Internal backend shared secret (required in production)
# Used by Next.js API routes to authenticate against the Python backend.
# Generate: openssl rand -base64 32
INTERNAL_BACKEND_SECRET=

# ─── Cloudflare CDN ────────────────────────────────────────────────
# Cloudflare Zone ID (found in Cloudflare dashboard Overview sidebar)
CLOUDFLARE_ZONE_ID=
# Cloudflare API Token with Zone:Cache:Purge and Zone:Zone:Read permissions
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 / any S3-compatible store (optional — SuperAdmin Settings → Cloudflare)
# Same upload path works for AWS, GCS HMAC, Hetzner Object Storage, MinIO on a VPS.
S3_PROVIDER=r2
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Local Dev Seed (scripts/seed-dev-users.ts) ─────────────────────────────

# Dev-only account passwords — the seed script REFUSES to run with defaults
# unless each is explicitly set (never use these values in production).
SEED_SUPERADMIN_PASS=
SEED_ADMIN_PASS=
SEED_DEMO_PASS=
SEED_QA_PASS=

# Emergency override allowing the seed script under NODE_ENV=production.
# NEVER set this in production — it upserts privileged accounts.
ALLOW_SEED_PROD=
